{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinfoil.sh/conformance/v3/output.schema.json",
  "title": "v3 conformance adapter Output",
  "description": "The stdout JSON an adapter emits. Exactly one of outputs / rejection is present. The exit code (0/10/20/30/1) carries the verdict; this is diagnostic.",
  "type": "object",
  "required": ["stage", "accepted"],
  "additionalProperties": false,
  "properties": {
    "stage": { "type": "string" },
    "accepted": { "type": "boolean" },
    "outputs": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "code_digest": { "type": "string" },
        "code_measurement": { "$ref": "#/$defs/measurement" },
        "enclave_measurement": { "$ref": "#/$defs/measurement" }
      }
    },
    "rejection": {
      "type": "object",
      "required": ["code"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": ["ENVELOPE_REJECTED", "PROVENANCE_REJECTED", "QUOTE_REJECTED", "POLICY_REJECTED", "MALFORMED_INPUT"]
        }
      }
    }
  },
  "$defs": {
    "measurement": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "registers": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinfoil.sh/conformance/v3/fixture.schema.json",
  "title": "v3 conformance fixture",
  "description": "One shared, language-neutral conformance case: an Input driven through a stage, with the expected verdict and (for rejects) the spec-layer reject code. Which Input members a stage requires is stated per stage in allOf below.",
  "type": "object",
  "required": ["id", "stage", "input", "expected"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Unique, filesystem-safe fixture id."
    },
    "stage": {
      "description": "Adapter stage this case drives.",
      "enum": [
        "v3-check-envelope",
        "v3-authenticate-provenance",
        "v3-assemble-policy",
        "v3-authenticate-quote",
        "verify-attestation-v3",
        "v3-authenticate-approval",
        "v3-verify-timestamp"
      ]
    },
    "input": { "$ref": "input.schema.json" },
    "expected": {
      "type": "object",
      "required": ["accepted"],
      "additionalProperties": false,
      "properties": {
        "accepted": { "type": "boolean" },
        "code": {
          "description": "Spec-layer reject code (the target rule's matrix layer). Present iff accepted=false.",
          "enum": [
            "ENVELOPE_REJECTED",
            "PROVENANCE_REJECTED",
            "QUOTE_REJECTED",
            "POLICY_REJECTED",
            "MALFORMED_INPUT"
          ]
        },
        "tls_public_key_fp": {
          "type": "string",
          "description": "Endorsed TLS SPKI fingerprint the verified document must recover (accept fixtures only)."
        },
        "hpke_public_key": {
          "type": "string",
          "description": "Endorsed HPKE public key the verified document must recover (accept fixtures only)."
        },
        "code_digest": {
          "type": "string",
          "description": "Verified code artifact digest the accept must yield (accept fixtures only)."
        },
        "code_measurement": {
          "type": "object",
          "description": "Verified code measurement {type, registers} the accept must yield.",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string" },
            "registers": { "type": "array", "items": { "type": "string" } }
          }
        },
        "enclave_measurement": {
          "type": "object",
          "description": "Verified enclave measurement {type, registers} the accept must yield.",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string" },
            "registers": { "type": "array", "items": { "type": "string" } }
          }
        },
        "signing_key_hint": {
          "type": "string",
          "description": "v3-authenticate-approval: the hint (standard base64 of SHA-256 over the DER SubjectPublicKeyInfo) of the pinned key the accept must report as the one that verified (accept fixtures only)."
        },
        "timestamp": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "description": "v3-verify-timestamp: the TSTInfo genTime the accept must report, RFC 3339 in UTC at second precision (accept fixtures only)."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "accepted": { "const": false } } },
          "then": { "required": ["code"] },
          "else": { "not": { "required": ["code"] } }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "v3-check-envelope",
              "v3-authenticate-provenance",
              "v3-assemble-policy",
              "v3-authenticate-quote",
              "verify-attestation-v3"
            ]
          }
        }
      },
      "then": {
        "properties": { "input": { "required": ["document_b64"] } }
      }
    },
    {
      "if": { "properties": { "stage": { "const": "v3-authenticate-approval" } } },
      "then": {
        "properties": {
          "input": { "required": ["bundle_json_b64", "signing_keys_pem", "artifact_digest_hex"] }
        }
      }
    },
    {
      "if": { "properties": { "stage": { "const": "v3-verify-timestamp" } } },
      "then": {
        "properties": {
          "input": {
            "required": ["timestamp_response_b64", "timestamp_input_b64", "verification_time_unix"],
            "properties": { "verification_time_unix": { "minimum": 1 } }
          }
        }
      }
    }
  ]
}
